# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# LLM API Keys (for synthetic data generation)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Ollama Configuration (local models)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama2

# Hugging Face
HUGGINGFACE_TOKEN=your_huggingface_token_here

# Weights & Biases (optional, for training tracking)
WANDB_API_KEY=your_wandb_api_key_here
WANDB_PROJECT=model-training

# Training Configuration Defaults
DEFAULT_MAX_SEQ_LENGTH=2048
DEFAULT_BATCH_SIZE=2
DEFAULT_GRADIENT_ACCUMULATION_STEPS=4
DEFAULT_LEARNING_RATE=2e-4
DEFAULT_NUM_TRAIN_EPOCHS=3

# Paths
PROJECTS_DIR=./projects
MODELS_DIR=./models
DATASETS_DIR=./datasets

# Storage
MAX_DATASET_SIZE_GB=10
MAX_MODEL_SIZE_GB=50

# Discord AOTR Webhook Bot Configuration
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_CHANNEL_ID=your_channel_id_here
DISCORD_USER_ID=your_user_id_here
WEBHOOK_PORT=5555
WEBHOOK_SECRET=your_webhook_secret_here
